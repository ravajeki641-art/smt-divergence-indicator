//@version=6
indicator("Nox ★", overlay=true, max_labels_count=100)

// ==================== INPUT ====================
swingLen      = input.int(5, "Swing Length", minval=2)
refSymbol     = input.symbol("NQ1!", "Correlated Asset")
minBars       = input.int(10, "Min Bars Between Pivots", minval=1)
showLabels    = input.bool(true, "Show Labels")
showBg        = input.bool(true, "Highlight Background")

// ==================== REQUEST SECURITY ====================
refHigh = request.security(refSymbol, timeframe.period, high)
refLow  = request.security(refSymbol, timeframe.period, low)

// ==================== PIVOT CHECK ====================
// Main chart
mainPivotLow  = ta.pivotlow(low, swingLen, swingLen)
mainPivotHigh = ta.pivothigh(high, swingLen, swingLen)

// Correlated asset
refPivotLow  = ta.pivotlow(refLow, swingLen, swingLen)
refPivotHigh = ta.pivothigh(refHigh, swingLen, swingLen)

// ==================== LAST PIVOT STATE ====================
var int lastMainLowBar = na
var int lastMainHighBar = na
var int lastRefLowBar = na
var int lastRefHighBar = na

var float lastMainLowVal = na
var float lastMainHighVal = na
var float lastRefLowVal = na
var float lastRefHighVal = na

if mainPivotLow != na
    lastMainLowBar := bar_index
    lastMainLowVal := mainPivotLow

if mainPivotHigh != na
    lastMainHighBar := bar_index
    lastMainHighVal := mainPivotHigh

if refPivotLow != na
    lastRefLowBar := bar_index
    lastRefLowVal := refPivotLow

if refPivotHigh != na
    lastRefHighBar := bar_index
    lastRefHighVal := refPivotHigh

// ==================== SMT LOGIC - ONLY VALID BIAS ====================

// Bullish Reversal:
bullishReversal = not na(lastMainLowVal) and not na(lastRefLowVal) and
                 lastMainLowVal < lastRefLowVal and
                 lastMainLowBar > lastRefLowBar and
                 (bar_index - lastMainLowBar) <= minBars

// Bullish Continuation:
bullishContinuation = not na(lastMainLowVal) and not na(lastRefLowVal) and
                     lastMainLowVal < lastRefLowVal and
                     lastMainLowBar < lastRefLowBar and
                     (bar_index - lastRefLowBar) <= minBars

// Bearish Reversal:
bearishReversal = not na(lastMainHighVal) and not na(lastRefHighVal) and
                 lastMainHighVal > lastRefHighVal and
                 lastMainHighBar > lastRefHighBar and
                 (bar_index - lastMainHighBar) <= minBars

// Bearish Continuation:
bearishContinuation = not na(lastMainHighVal) and not na(lastRefHighVal) and
                     lastMainHighVal > lastRefHighVal and
                     lastMainHighBar < lastRefHighBar and
                     (bar_index - lastRefHighBar) <= minBars

// ==================== LABELS ====================
plotshape(showLabels and bullishReversal, title="Bullish Reversal", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BULLISH\nREVERSAL", textcolor=color.white)
plotshape(showLabels and bullishContinuation, title="Bullish Continuation", style=shape.labelup, location=location.belowbar, color=color.new(color.blue, 0), text="BULLISH\nCONT", textcolor=color.white)
plotshape(showLabels and bearishReversal, title="Bearish Reversal", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="BEARISH\nREVERSAL", textcolor=color.white)
plotshape(showLabels and bearishContinuation, title="Bearish Continuation", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), text="BEARISH\nCONT", textcolor=color.white)

// ==================== BG HIGHLIGHT ====================
bgcolor(showBg and bullishReversal ? color.new(color.lime, 88) :
       showBg and bullishContinuation ? color.new(color.blue, 88) :
       showBg and bearishReversal ? color.new(color.red, 88) :
       showBg and bearishContinuation ? color.new(color.orange, 88) : na)

// ==================== ALERTS ====================
alertcondition(bullishReversal, title="Bullish Reversal SMT", message="BULLISH REVERSAL SMT detected")
alertcondition(bullishContinuation, title="Bullish Continuation SMT", message="BULLISH CONTINUATION SMT detected")
alertcondition(bearishReversal, title="Bearish Reversal SMT", message="BEARISH REVERSAL SMT detected")
alertcondition(bearishContinuation, title="Bearish Continuation SMT", message="BEARISH CONTINUATION SMT detected")
